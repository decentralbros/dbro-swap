{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [],
      "outputs": ["dist/**", ".next/**/*", "!.next/cache/**", "!.vercel/**/*"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
    },
    "test:config": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["@pancakeswap/next-config#build"],
      "outputs": [],
      "inputs": ["src/**/*.tsx", "src/**/*.ts", "src/**/*.js", "src/**/*.jsx"]
    },
    "dev": {
      "dependsOn": ["@pancakeswap/next-config#build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "build:uikit": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:list": {
      "outputs": ["list/**"]
    },
    "integration-test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
