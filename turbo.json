{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["RISK_APP_SECRET", "SERVER_NODE_REAL_API_ETH", "SERVER_NODE_REAL_API_GOERLI", "NODE_ENV"],
      "outputs": ["dist/**", ".next/**/*", "!.next/cache/**", "!.vercel/**/*"],
      "cache": true,
      "inputs": ["src/**", "package.json", "tsconfig.json", "next.config.js", "vite.config.ts"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**/*.test.{js,jsx,ts,tsx}", "test/**/*"],
      "cache": true
    },
    "test:config": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["config/**/*", "test/**/*"]
    },
    "build:storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"],
      "cache": true,
      "inputs": [".storybook/**/*", "src/**/*.stories.{js,jsx,ts,tsx}", "src/**/*.{css,scss}"]
    },
    "build:uikit": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true,
      "inputs": ["src/**/*", "package.json", "tsconfig.json"]
    },
    "build:list": {
      "outputs": ["list/**"],
      "cache": true,
      "inputs": ["lists/**/*", "src/tokens/**/*"]
    },
    "lint": {
      "dependsOn": ["@pancakeswap/next-config#build"],
      "outputs": [".eslintcache"],
      "cache": true,
      "inputs": ["src/**/*.{js,jsx,ts,tsx}", ".eslintrc*", "package.json"]
    },
    "dev": {
      "dependsOn": ["@pancakeswap/next-config#build"],
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "integration-test": {
      "dependsOn": ["^build"],
      "outputs": ["test-results/**"],
      "cache": true,
      "inputs": ["integration-tests/**/*"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": ["**/.env.*local", "tsconfig.json", "turbo.json"],
  "globalEnv": ["NODE_ENV", "CI", "VERCEL"],
  "remoteCache": {
    "signature": true,
    "enabled": true
  }
}
